FEC_API_KEY=your_fec_api_key_here
# Comma-separated hostnames accepted by the hosted HTTP transport.
# Example for Render: fec-mcp-server.onrender.com
# MCP_ALLOWED_HOSTS=fec-mcp-server.onrender.com
# Optional: require Authorization: Bearer <token> on the HTTP /mcp endpoint.
# MCP_AUTH_TOKEN=replace_with_a_long_random_token
# Optional: override default request timeout in milliseconds (30000 for most
# tools, 60000 for donor_search / spending_search)
# FEC_API_TIMEOUT_MS=30000
